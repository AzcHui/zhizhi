<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- b2-b1 托盘：NotifyIcon 来自 WinForms —— 与 WPF 同项目必须双开 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zhizhi.Shell</RootNamespace>
    <AssemblyName>Zhizhi.Shell</AssemblyName>
    <Version>0.1.0</Version>
    <Description>只只的正式外壳（M4-b1 最小可跑壳）—— WPF 球形浮窗，自己养内核</Description>
    <!-- 框架依赖发布：目标机已有 .NET 8 桌面 runtime（8.0.27），单 exe 只有几百 KB -->
    <SelfContained>false</SelfContained>
    <!-- WinExe 不弹控制台；self-test 模式用 AttachConsole 接回父控制台输出 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- ⭐ WinForms 的隐式 using 会把 System.Drawing / System.Windows.Forms 注入所有文件，
       与 WPF 的 Point / Color / Brush / MessageBox 撞名（CS0104 一片红）——
       全局移除，用到的 WinForms 类型一律全限定名。 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- ⭐ 只只的家（M11-c）：WPF 内嵌 WebView2 承载 Vue3 单页。
       WebView2 走 NuGet 的托管封装；运行时（Edge WebView2 Runtime）本机已装。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- ⭐⭐ 根治 P0（2026-10-22）：WebView2 托管 DLL 必须**无条件**进输出目录。
       起因：这个包的托管 DLL 不在 lib/ 而在 lib_manual/（非标准布局），靠包自己的
       buildTransitive/*.targets 里的 <Reference> 注入。**该注入走 RAR（ResolveAssemblyReference）**，
       而 RAR 有增量缓存（obj/…/Zhizhi.Shell.csproj.AssemblyReference.cache）——
       一旦缓存命中（如：先 publish/构建到别的目录，再增量构建回默认输出），
       **RAR 不再重新解析 → ReferenceCopyLocalPaths 为空 → 三个 Microsoft.Web.WebView2.*.dll 不被复制**
       → 运行时抛「Could not load file or assembly 'Microsoft.Web.WebView2.Core'…系统找不到指定的文件」。
       现象：home-test 全绿（用的是干净构建产物），用户双击 bin/Debug 的 exe 就报「找不到文件」。
       修法：不依赖 RAR 的增量判断，直接把三个托管 DLL + 原生 loader 声明成 Content，
             CopyToOutputDirectory=Always —— 每次构建都复制，删了也会补回来。 -->
  <PropertyGroup>
    <!-- WebView2 包版本号（与上面的 PackageReference 保持一致；升级时两处同改） -->
    <WebView2PackageVersion>1.0.2903.40</WebView2PackageVersion>
    <WebView2PackageRoot>$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2PackageVersion)\</WebView2PackageRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- 三个托管封装（Core 必需；Wpf 是本项目用的；WinForms 随包一起带上免得以后引 WinForms 再踩坑） -->
    <Content Include="$(WebView2PackageRoot)lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll">
      <Link>Microsoft.Web.WebView2.Core.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(WebView2PackageRoot)lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Wpf.dll">
      <Link>Microsoft.Web.WebView2.Wpf.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(WebView2PackageRoot)lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll">
      <Link>Microsoft.Web.WebView2.WinForms.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <!-- 原生 loader（x64 为主，三个架构都带上 —— AnyCPU 发布时按需选） -->
    <Content Include="$(WebView2PackageRoot)runtimes\win-x64\native\WebView2Loader.dll">
      <Link>runtimes\win-x64\native\WebView2Loader.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(WebView2PackageRoot)runtimes\win-x86\native\WebView2Loader.dll">
      <Link>runtimes\win-x86\native\WebView2Loader.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

</Project>
