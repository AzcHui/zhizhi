{
  "name": "zhizhi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "只只 —— 让电脑「活起来」的系统生命体征助手",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "pnpm --filter @zhizhi/cli start",
    "once": "pnpm --filter @zhizhi/cli once",
    "typecheck": "tsc --noEmit",
    "build:home": "pnpm --filter @zhizhi/home build",
    "dev:home": "pnpm --filter @zhizhi/home dev",
    "build:shell": "dotnet build shell/Zhizhi.Shell/Zhizhi.Shell.csproj -c Debug",
    "build:all": "pnpm build:home && pnpm build:shell"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0"
  }
}
