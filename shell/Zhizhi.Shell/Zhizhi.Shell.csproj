<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- b2-b1 托盘：NotifyIcon 来自 WinForms —— 与 WPF 同项目必须双开 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zhizhi.Shell</RootNamespace>
    <AssemblyName>Zhizhi.Shell</AssemblyName>
    <Version>0.1.0</Version>
    <Description>只只的正式外壳（M4-b1 最小可跑壳）—— WPF 球形浮窗，自己养内核</Description>
    <!-- 框架依赖发布：目标机已有 .NET 8 桌面 runtime（8.0.27），单 exe 只有几百 KB -->
    <SelfContained>false</SelfContained>
    <!-- WinExe 不弹控制台；self-test 模式用 AttachConsole 接回父控制台输出 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- ⭐ WinForms 的隐式 using 会把 System.Drawing / System.Windows.Forms 注入所有文件，
       与 WPF 的 Point / Color / Brush / MessageBox 撞名（CS0104 一片红）——
       全局移除，用到的 WinForms 类型一律全限定名。 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- ⭐ 只只的家（M11-c）：WPF 内嵌 WebView2 承载 Vue3 单页。
       WebView2 走 NuGet 的托管封装；运行时（Edge WebView2 Runtime）本机已装。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
